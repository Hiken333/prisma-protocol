# Persistent shadow secret (generate: openssl rand -hex 32)
PRISM_SHADOW_SK=

# Reality decoy SNI (must match cert CN/SAN)
PRISM_DECOY=www.google.com

# UDP listen address (host network — binds on VPS directly)
PRISM_LISTEN=0.0.0.0:4433

# Server-side TUN (client uses 172.19.0.2/30)
PRISM_TUN_NAME=prism0
PRISM_TUN_CIDR=172.19.0.1/30

# Optional: override WAN iface for NAT (auto-detected if empty)
# PRISM_WAN_IFACE=eth0

# Optional: PRISM_FAST=1 disables morph padding on the server (less stealth).
# PRISM_PERF=1
# BOLT lanes: UDP base_port+1 .. +N (default N=4 → 4434-4437 for listen 4433).
# PRISM_BOLT_LANES=4
# PRISM_BOLT_MBPS=200 on the server enables full throughput tuning for every session
# (padding off, BBR, no pacing). On the Windows client, enable perf in
# Settings → Performance mode (auto-saved); the server also mirrors client perf
# from the handshake when only the client has perf.
# PRISM_AGENT_DEBUG=1 — throughput debug NDJSON (grep agent_debug in docker logs)

PRISM_DATA_DIR=/var/lib/prism
